# Copie para .env e ajuste conforme necessario.

# Porta em que a API escuta.
PORT=3000

# String de conexao com o Postgres.
# Ao rodar em compose, o host costuma ser o nome do servico do banco (ex: db).
DATABASE_URL=postgres://docker:docker@localhost:5432/docker

# Credenciais usadas pela imagem oficial do Postgres.
POSTGRES_USER=docker
POSTGRES_PASSWORD=docker
POSTGRES_DB=docker
